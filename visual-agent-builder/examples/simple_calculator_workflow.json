  "test_cases": [
    {
      "name": "Basic Addition",
      "input": "What is 5 + 3?",
      "expected_output": "8",
      "description": "Test basic addition operation"
    },
    {
      "name": "Basic Multiplication",
      "input": "What is 4 * 7?",
      "expected_output": "28",
      "description": "Test basic multiplication operation"
    },
    {
      "name": "Complex Calculation",
      "input": "What is (10 + 5) * 2?",
      "expected_output": "30",
      "description": "Test complex calculation with parentheses"
    },
    {
      "name": "Time Question",
      "input": "What time is it now?",
      "expected_output": "current time",
      "description": "Test datetime functionality"
    },
    {
      "name": "Mixed Operations",
      "input": "If I have 20 apples and eat 3, then buy 5 more, how many do I have?",
      "expected_output": "22",
      "description": "Test mixed arithmetic operations"
    }
  ],
  "usage_instructions": {
    "description": "This workflow creates a calculator agent that can perform basic mathematical operations and answer questions about calculations.",
    "capabilities": [
      "Perform basic arithmetic operations (add, subtract, multiply, divide)",
      "Answer questions about mathematical calculations",
      "Provide current date and time information",
      "Handle complex multi-step calculations"
    ],
    "example_queries": [
      "What is 15 + 27?",
      "Calculate 8 * 9",
      "What is 100 divided by 4?",
      "If I have 50 dollars and spend 23, how much do I have left?",
      "What time is it now?",
      "What is the result of (5 + 3) * 2 - 4?"
    ],
    "limitations": [
      "Only supports basic arithmetic operations",
      "Cannot handle advanced mathematical functions (trigonometry, calculus, etc.)",
      "Limited to numerical calculations"
    ]
  },
  "deployment_notes": {
