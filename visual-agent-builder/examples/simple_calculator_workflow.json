    },
    "deployment_steps": [
      "1. Ensure NeMo-Agent-Toolkit is installed",
      "2. Set up NVIDIA NIM API credentials",
      "3. Export the workflow to YAML",
      "4. Run: aiq serve --config_file=workflow.yml",
      "5. Test with: aiq run --config_file=workflow.yml"
